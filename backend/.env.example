# Database
DATABASE_URL=postgresql://hallhustle:password@localhost:5432/hallhustle

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Paystack (get these from your Paystack dashboard: Settings > API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brevo (email OTP verification) — https://brevo.com, free tier 300/day
# Get your API key from Brevo dashboard > Settings > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a single email address you've verified in Brevo (Senders, Domains &
# Dedicated IPs > Senders) — no full domain/DNS verification required to start.
BREVO_SENDER_EMAIL=verify@yourdomain.com
BREVO_SENDER_NAME=HallHustle
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Cloudinary (listing photo uploads) — https://cloudinary.com, free tier ~25GB storage/bandwidth
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
APP_NAME=HallHustle
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
# Comma-separated list of additional allowed origins (your deployed frontend URL(s)).
# Any https://*.vercel.app origin is already allowed automatically via regex,
# so you only need to add this if you're using a custom domain.
ALLOWED_ORIGINS=http://localhost:3000,https://your-custom-domain.com

# Leave empty to accept any email. Set a comma-separated list (e.g. unilag.edu.ng,live.unilag.edu.ng) to restrict signups.
ALLOWED_EMAIL_DOMAINS=
